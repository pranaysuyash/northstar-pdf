      "sha256",
      "sourceKind",
      "lineage",
      "privacyClass",
      "documentClasses",
      "expectedInspection",
      "allowedOperations",
      "requiredValidators",
      "refreshPolicy"
    ],
    "digest": "SHA-256 over retained artifact bytes",
    "lineageRule": "Derived artifacts must name the source fixture and generator command. External samples must record acquisition and license status without inferring permission from availability.",
