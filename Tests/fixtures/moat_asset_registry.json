  "privacyPolicy": {
    "defaultRetention": "local-regression-only",
    "allowedLogFields": ["assetId", "fixtureId", "sourceDigest", "providerId", "status", "counter", "errorCode", "timing", "reportDigest"],
    "forbiddenLogFields": ["pageText", "ocrText", "groundTruth", "profileValue", "password", "imagePixels", "sourceBytes", "signatureAsset"],
    "learningRule": "Only reviewed and validated corrections may produce a pending learning event. No registry entry grants permission for silent autofill or source mutation."
  },
